# ==============================================================================
# NAMUNA ENV — nusxalab .env yarating va qiymatlarni to'ldiring
# .env hech qachon git'ga tushmaydi (.gitignore)
# ==============================================================================

# ==============================================================================
# TELEGRAM BOT & ADMINS
# ==============================================================================
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_here
ADMIN_IDS=8544023815,8112688757

# Admin to'g'ridan-to'g'ri kirish parollari (bo'sh bo'lsa — faqat Telegram auth ishlaydi)
ADMIN_1_PASSWORD=
ADMIN_2_PASSWORD=

# ==============================================================================
# SUPABASE CREDENTIALS
# MUHIM: Supabase SQL Editor'da backend/schema.sql ishga tushirilishi kerak!
# Jadvallar bo'lmasa backend avtomatik SQLite fallback'ga o'tadi.
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# CLOUDFLARE R2 STORAGE
# Bucket PRIVATE: media /api/media/{key} proxy orqali presigned URL bilan ochiladi.
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=course
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Backendning o'zi ochiq manzili — media havolalari shu manzilga quriladi
# (Render/VPS dagi public URL, localhost emas!)
API_PUBLIC_URL=https://your-backend.onrender.com

# ==============================================================================
# SECURITY & JWT
# ==============================================================================
JWT_SECRET=strong_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Telegram initData tekshiruvida auth_date ning maksimal yoshi (soatda).
# Eski initData qayta ishlatilishi (replay) shu muddatdan keyin bloklanadi.
TELEGRAM_AUTH_MAX_AGE_HOURS=24

# ==============================================================================
# AI KURS GENERATORI (OpenRouter) — faqat admin panel uchun
# AI chat olib tashlangan; bu sozlamalar faqat admin "Kurs yaratish" generatorida
# ishlatiladi. Qwen3.8 Flash tezkor va tejamkor. Model IDlar vaqt o'tishi bilan
# o'zgarishi mumkin; OpenRouter dashboardidan tekshirib turing.
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_MAX_TOKENS=900
OPENROUTER_RETRY_ATTEMPTS=2
# true qilinsa Qwen ishlamaganida Groq fallback ham ishlatiladi.
ENABLE_AI_PROVIDER_FALLBACKS=false

# ==============================================================================
# TO'LOV REKVIZITLARI
# ==============================================================================
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=Ism Familiya
CARD_BANK=Uzcard / Humo
PAYME_PAYMENT_URL=https://payme.uz/your-payment-link
CLICK_PAYMENT_URL=https://my.click.uz/your-payment-link
UZUM_PAYMENT_URL=

# ==============================================================================
# WEBAPP URL & CORS
# ==============================================================================
WEBAPP_URL=https://your-miniapp-domain.vercel.app
WELCOME_BANNER_URL=https://your-cdn.example/course-academy-welcome.jpg
CORS_ORIGINS=https://your-miniapp-domain.vercel.app,http://localhost:3000
